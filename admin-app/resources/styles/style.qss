QMainWindow,
QDialog {
    background: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #c4f2db,
        stop:1 #72cf94
    );
}

QWidget {
    color: #1f3a32;
    font-family: "Segoe UI";
    font-size: 11pt;
}

QLabel[objectName^="title"] {
    font-size: 24pt;
    font-weight: 600;
    color: #16352b;
}

QLabel[objectName^="hint"] {
    font-size: 14pt;
    color: #16352b;
}

QLabel[objectName^="labelInfo"] {
    color: #8a3a3a;
    font-size: 12pt;
    font-weight: 600;
}

QLabel {
    font-size: 12pt;
    color: #2b4a40;
}


QLineEdit {
    background-color: #f4fbf8;
    color: #1f3a32;
    border: 1px solid #6fae99;
    border-radius: 6px;
    padding: 6px;
}

QComboBox {
    background-color: #f4fbf8;
    color: #1f3a32;
    border: 1px solid #6fae99;
    border-radius: 6px;
    padding: 6px 8px;
}

QLineEdit:focus {
    background-color: #ffffff;
    border-color: #5a9a86;
}

QPushButton {
    background-color: #eef7f3;
    color: #1f3a32;

    font-size: 10pt;
    font-weight: 500;

    padding: 4px 12px;
    min-height: 24px;

    border: 1px solid #6fae99;
    border-radius: 8px;
}

QPushButton:hover {
    background-color: #e0f0ea;
}

QPushButton:pressed {
    background-color: #cfe6dd;
}

QTableView {
    background-color: #eef7f3;
    alternate-background-color: #e2f0ea;
    gridline-color: #9fc3b4;

    color: #1f3a32;
    selection-background-color: #c7e4d8;
    selection-color: #1f3a32;

    border: 1px solid #9fc3b4;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #d6eee5;
    color: #1f3a32;
    border: 1px solid #9fc3b4;
    padding: 6px;
    font-weight: 600;
}
